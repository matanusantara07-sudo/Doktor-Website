# APLIKASI.X Backend Configuration
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aplikasi_x
DB_USER=aplikasi_x_user
DB_PASSWORD=your_secure_password_here
DB_POOL_MAX=20
DB_POOL_MIN=5

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# WordPress Integration
WP_SITE_URL=https://your-wordpress-site.com
WP_API_URL=https://your-wordpress-site.com/wp-json/wp/v2
WP_USERNAME=api_user
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=info
LOG_FILE=logs/aplikasi-x.log

# System Mode
SYSTEM_MODE=OBSERVE_ONLY
# Options: OBSERVE_ONLY | SEMI_AUTOMATION | FULL_AUTOMATION (not recommended)

# Publishing Configuration
AUTO_PUBLISH_ENABLED=false
MAX_PUBLISH_PER_HOUR=5

# Google Analytics (Read-Only)
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_KEY_PATH=

# Google Search Console (Read-Only)
GSC_SITE_URL=
GSC_SERVICE_ACCOUNT_KEY_PATH=

# Alert Configuration
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Slack Webhook (Optional)
SLACK_WEBHOOK_URL=

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_here

# Audit Log
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=logs/audit.jsonl
